{
  "$description": "Primitive tokens: raw scales with no meaning attached. Components never read these directly; semantic.json gives them meaning. Every token compiles to --aihio-<group>-<name>, lowercase and hyphenated, so a name needs no escaping where it is read.",
  "color": {
    "zinc": {
      "$description": "Neutral ramp. Hue 286 with near-zero chroma gives the cool, almost-achromatic grey the system reads as 'no colour', and the 0/1000 ends are true white and true black so page canvases are pure rather than tinted.",
      "0":    { "$value": "oklch(1 0 0)", "$type": "color" },
      "50":   { "$value": "oklch(0.9707 0.0027 286)", "$type": "color" },
      "100":  { "$value": "oklch(0.9406 0.0027 286)", "$type": "color" },
      "200":  { "$value": "oklch(0.9020 0.0040 286)", "$type": "color" },
      "300":  { "$value": "oklch(0.8700 0.0060 286)", "$type": "color" },
      "400":  { "$value": "oklch(0.7600 0.0070 286)", "$type": "color" },
      "450":  { "$value": "oklch(0.7105 0.0072 286)", "$type": "color" },
      "500":  { "$value": "oklch(0.6217 0.0074 286)", "$type": "color" },
      "550":  { "$value": "oklch(0.5399 0.0077 286)", "$type": "color" },
      "600":  { "$value": "oklch(0.4800 0.0070 286)", "$type": "color" },
      "700":  { "$value": "oklch(0.4000 0.0060 286)", "$type": "color" },
      "800":  { "$value": "oklch(0.3200 0.0050 286)", "$type": "color" },
      "850":  { "$value": "oklch(0.2603 0.0040 286)", "$type": "color" },
      "900":  { "$value": "oklch(0.2316 0.0038 286)", "$type": "color" },
      "950":  { "$value": "oklch(0.2006 0.0020 286)", "$type": "color" },
      "1000": { "$value": "oklch(0 0 0)", "$type": "color" }
    },
    "red": {
      "50":  { "$value": "oklch(0.97 0.013 18)", "$type": "color" },
      "100": { "$value": "oklch(0.94 0.028 22)", "$type": "color" },
      "200": { "$value": "oklch(0.89 0.055 22)", "$type": "color" },
      "300": { "$value": "oklch(0.82 0.095 22)", "$type": "color" },
      "400": { "$value": "oklch(0.71 0.155 25)", "$type": "color" },
      "500": { "$value": "oklch(0.63 0.196 25)", "$type": "color" },
      "600": { "$value": "oklch(0.56 0.200 27)", "$type": "color" },
      "700": { "$value": "oklch(0.47 0.170 27)", "$type": "color" },
      "800": { "$value": "oklch(0.40 0.140 25)", "$type": "color" },
      "900": { "$value": "oklch(0.35 0.110 25)", "$type": "color" },
      "950": { "$value": "oklch(0.22 0.080 25)", "$type": "color" }
    },
    "green": {
      "300": { "$value": "oklch(0.84 0.120 150)", "$type": "color" },
      "400": { "$value": "oklch(0.72 0.150 150)", "$type": "color" },
      "500": { "$value": "oklch(0.62 0.150 150)", "$type": "color" },
      "600": { "$value": "oklch(0.52 0.140 150)", "$type": "color" },
      "700": { "$value": "oklch(0.44 0.120 150)", "$type": "color" }
    },
    "amber": {
      "300": { "$value": "oklch(0.88 0.100 75)", "$type": "color" },
      "400": { "$value": "oklch(0.80 0.160 75)", "$type": "color" },
      "500": { "$value": "oklch(0.74 0.155 75)", "$type": "color" },
      "600": { "$value": "oklch(0.60 0.120 75)", "$type": "color" },
      "700": { "$value": "oklch(0.52 0.100 75)", "$type": "color" }
    }
  },
  "radius": {
    "$description": "Every step is computed from base, so one override rounds the whole system.",
    "base": { "$value": "0.5rem", "$type": "dimension" },
    "none": { "$value": "0", "$type": "dimension" },
    "sm":   { "$value": "calc({radius.base} - 4px)", "$type": "dimension" },
    "md":   { "$value": "calc({radius.base} - 2px)", "$type": "dimension" },
    "lg":   { "$value": "{radius.base}", "$type": "dimension" },
    "xl":   { "$value": "calc({radius.base} + 4px)", "$type": "dimension" },
    "2xl":  { "$value": "calc({radius.base} + 8px)", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "spacing": {
    "$description": "Steps of 0.25rem. Half steps are written with a hyphen, so 1-5 is 0.375rem.",
    "0":    { "$value": "0", "$type": "dimension" },
    "0-5":  { "$value": "0.125rem", "$type": "dimension" },
    "1":    { "$value": "0.25rem", "$type": "dimension" },
    "1-5":  { "$value": "0.375rem", "$type": "dimension" },
    "2":    { "$value": "0.5rem", "$type": "dimension" },
    "2-5":  { "$value": "0.625rem", "$type": "dimension" },
    "3":    { "$value": "0.75rem", "$type": "dimension" },
    "3-5":  { "$value": "0.875rem", "$type": "dimension" },
    "4":    { "$value": "1rem", "$type": "dimension" },
    "5":    { "$value": "1.25rem", "$type": "dimension" },
    "6":    { "$value": "1.5rem", "$type": "dimension" },
    "8":    { "$value": "2rem", "$type": "dimension" },
    "10":   { "$value": "2.5rem", "$type": "dimension" },
    "12":   { "$value": "3rem", "$type": "dimension" },
    "16":   { "$value": "4rem", "$type": "dimension" },
    "20":   { "$value": "5rem", "$type": "dimension" },
    "24":   { "$value": "6rem", "$type": "dimension" }
  },
  "font-family": {
    "sans": {
      "$value": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", \"Inter\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\"",
      "$type": "fontFamily",
      "$description": "System-grade UI stack. The platform face leads so text renders in the grey the OS already optimises for; no webfont is shipped, which keeps the package zero-dependency."
    },
    "mono": {
      "$value": "ui-monospace, \"SF Mono\", \"Cascadia Code\", \"JetBrains Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
      "$type": "fontFamily",
      "$description": "Monospace stack for code, markup samples, and token values."
    }
  },
  "font-size": {
    "xs":   { "$value": "0.75rem", "$type": "dimension" },
    "sm":   { "$value": "0.875rem", "$type": "dimension" },
    "base": { "$value": "1rem", "$type": "dimension" },
    "lg":   { "$value": "1.125rem", "$type": "dimension" },
    "xl":   { "$value": "1.25rem", "$type": "dimension" },
    "2xl":  { "$value": "1.5rem", "$type": "dimension" },
    "3xl":  { "$value": "1.875rem", "$type": "dimension" },
    "4xl":  { "$value": "2.25rem", "$type": "dimension" }
  },
  "font-weight": {
    "normal":   { "$value": "400", "$type": "fontWeight" },
    "medium":   { "$value": "500", "$type": "fontWeight" },
    "semibold": { "$value": "600", "$type": "fontWeight" },
    "bold":     { "$value": "700", "$type": "fontWeight" }
  },
  "line-height": {
    "none":    { "$value": "1", "$type": "number" },
    "tight":   { "$value": "1.25", "$type": "number" },
    "snug":    { "$value": "1.375", "$type": "number" },
    "normal":  { "$value": "1.5", "$type": "number" },
    "relaxed": { "$value": "1.625", "$type": "number" }
  },
  "letter-spacing": {
    "$description": "Optical tracking. Large type is set tighter than small type, because the same em value reads looser as glyphs grow.",
    "tighter": { "$value": "-0.025em", "$type": "dimension" },
    "tight":   { "$value": "-0.018em", "$type": "dimension" },
    "normal":  { "$value": "-0.011em", "$type": "dimension" },
    "wide":    { "$value": "0.02em", "$type": "dimension" }
  },
  "shadow": {
    "sm":  { "$value": "0 1px 2px 0 oklch(0 0 0 / 0.05)", "$type": "shadow" },
    "md":  { "$value": "0 8px 24px -6px oklch(0 0 0 / 0.12), 0 2px 6px -2px oklch(0 0 0 / 0.08)", "$type": "shadow" },
    "lg":  { "$value": "0 24px 64px -12px oklch(0 0 0 / 0.22), 0 6px 16px -6px oklch(0 0 0 / 0.12)", "$type": "shadow" }
  },
  "duration": {
    "fast":   { "$value": "100ms", "$type": "duration" },
    "normal": { "$value": "150ms", "$type": "duration" },
    "slow":   { "$value": "200ms", "$type": "duration" },
    "spin":   { "$value": "700ms", "$type": "duration" }
  }
}
