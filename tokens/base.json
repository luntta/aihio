    "amber": {
      "300": { "$value": "0.88 0.100 75", "$type": "color" },
      "400": { "$value": "0.80 0.160 75", "$type": "color" },
      "500": { "$value": "0.74 0.155 75", "$type": "color" },
      "600": { "$value": "0.60 0.120 75", "$type": "color" },
      "700": { "$value": "0.52 0.100 75", "$type": "color" }
    }
  },
  "radius": {
    "none": { "$value": "0", "$type": "dimension" },
    "sm":   { "$value": "calc(var(--radius) - 4px)", "$type": "dimension" },
    "md":   { "$value": "calc(var(--radius) - 2px)", "$type": "dimension" },
    "lg":   { "$value": "var(--radius)", "$type": "dimension" },
    "xl":   { "$value": "calc(var(--radius) + 4px)", "$type": "dimension" },
    "2xl":  { "$value": "calc(var(--radius) + 8px)", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "spacing": {
    "0":    { "$value": "0", "$type": "dimension" },
    "0.5":  { "$value": "0.125rem", "$type": "dimension" },
    "1":    { "$value": "0.25rem", "$type": "dimension" },
    "1.5":  { "$value": "0.375rem", "$type": "dimension" },
    "2":    { "$value": "0.5rem", "$type": "dimension" },
    "2.5":  { "$value": "0.625rem", "$type": "dimension" },
    "3":    { "$value": "0.75rem", "$type": "dimension" },
    "3.5":  { "$value": "0.875rem", "$type": "dimension" },
