{
  "$description": "Semantic aliases. Light and dark are built as mirror images of one another: a pure canvas, an elevated surface one step off it, and a hairline that only just separates them.",
  "light": {
    "background":           { "$value": "{color.zinc.0}", "$type": "color" },
    "foreground":           { "$value": "{color.zinc.900}", "$type": "color" },
    "card":                 { "$value": "{color.zinc.50}", "$type": "color" },
    "card-foreground":      { "$value": "{color.zinc.900}", "$type": "color" },
    "popover":              { "$value": "{color.zinc.0}", "$type": "color" },
    "popover-foreground":   { "$value": "{color.zinc.900}", "$type": "color" },
    "popover-highlight":    { "$value": "{color.zinc.100}", "$type": "color" },
    "primary":              { "$value": "{color.zinc.900}", "$type": "color" },
    "primary-foreground":   { "$value": "{color.zinc.0}", "$type": "color" },
    "secondary":            { "$value": "{color.zinc.100}", "$type": "color" },
    "secondary-foreground": { "$value": "{color.zinc.900}", "$type": "color" },
    "muted":                { "$value": "{color.zinc.50}", "$type": "color" },
    "muted-foreground":     { "$value": "{color.zinc.550}", "$type": "color" },
    "accent":               { "$value": "{color.zinc.100}", "$type": "color" },
    "accent-foreground":    { "$value": "{color.zinc.900}", "$type": "color" },
    "destructive":          { "$value": "{color.red.600}", "$type": "color" },
    "destructive-foreground": { "$value": "{color.zinc.0}", "$type": "color" },
    "destructive-text":     { "$value": "{color.red.600}", "$type": "color" },
    "success":              { "$value": "{color.green.600}", "$type": "color" },
    "success-foreground":   { "$value": "{color.zinc.0}", "$type": "color" },
    "success-text":         { "$value": "{color.green.600}", "$type": "color" },
    "warning":              { "$value": "{color.amber.400}", "$type": "color" },
    "warning-foreground":   { "$value": "{color.zinc.900}", "$type": "color" },
    "warning-text":         { "$value": "{color.amber.700}", "$type": "color" },
    "border":               { "$value": "{color.zinc.200}", "$type": "color" },
    "input":                { "$value": "{color.zinc.500}", "$type": "color" },
    "ring":                 { "$value": "{color.zinc.900}", "$type": "color" }
  },
  "dark": {
    "background":           { "$value": "{color.zinc.1000}", "$type": "color" },
    "foreground":           { "$value": "{color.zinc.50}", "$type": "color" },
    "card":                 { "$value": "{color.zinc.950}", "$type": "color" },
    "card-foreground":      { "$value": "{color.zinc.50}", "$type": "color" },
    "popover":              { "$value": "{color.zinc.900}", "$type": "color" },
    "popover-foreground":   { "$value": "{color.zinc.50}", "$type": "color" },
    "popover-highlight":    { "$value": "{color.zinc.800}", "$type": "color" },
    "primary":              { "$value": "{color.zinc.50}", "$type": "color" },
    "primary-foreground":   { "$value": "{color.zinc.1000}", "$type": "color" },
    "secondary":            { "$value": "{color.zinc.900}", "$type": "color" },
    "secondary-foreground": { "$value": "{color.zinc.50}", "$type": "color" },
    "muted":                { "$value": "{color.zinc.950}", "$type": "color" },
    "muted-foreground":     { "$value": "{color.zinc.450}", "$type": "color" },
    "accent":               { "$value": "{color.zinc.900}", "$type": "color" },
    "accent-foreground":    { "$value": "{color.zinc.50}", "$type": "color" },
    "destructive":          { "$value": "{color.red.600}", "$type": "color" },
    "destructive-foreground": { "$value": "{color.zinc.0}", "$type": "color" },
    "destructive-text":     { "$value": "{color.red.400}", "$type": "color" },
    "success":              { "$value": "{color.green.600}", "$type": "color" },
    "success-foreground":   { "$value": "{color.zinc.0}", "$type": "color" },
    "success-text":         { "$value": "{color.green.400}", "$type": "color" },
    "warning":              { "$value": "{color.amber.400}", "$type": "color" },
    "warning-foreground":   { "$value": "{color.zinc.1000}", "$type": "color" },
    "warning-text":         { "$value": "{color.amber.400}", "$type": "color" },
    "border":               { "$value": "{color.zinc.850}", "$type": "color" },
    "input":                { "$value": "{color.zinc.550}", "$type": "color" },
    "ring":                 { "$value": "{color.zinc.300}", "$type": "color" }
