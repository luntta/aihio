{
  "$description": "Component tokens: sizes specific to one component. They compile to --aihio-<component>-<name>.",
  "button": {
    "height": {
      "sm":   { "$value": "2.25rem", "$type": "dimension" },
      "md":   { "$value": "2.5rem", "$type": "dimension" },
      "lg":   { "$value": "2.75rem", "$type": "dimension" },
      "icon": { "$value": "2.5rem", "$type": "dimension" }
    },
    "padding-x": {
      "sm":   { "$value": "0.75rem", "$type": "dimension" },
      "md":   { "$value": "1rem", "$type": "dimension" },
      "lg":   { "$value": "2rem", "$type": "dimension" },
      "icon": { "$value": "0", "$type": "dimension" }
    },
    "font-size": {
      "sm":   { "$value": "{font-size.sm}", "$type": "dimension" },
      "md":   { "$value": "{font-size.sm}", "$type": "dimension" },
      "lg":   { "$value": "{font-size.base}", "$type": "dimension" }
    }
  },
  "input": {
    "height": {
      "sm":   { "$value": "2.25rem", "$type": "dimension" },
      "md":   { "$value": "2.5rem", "$type": "dimension" },
      "lg":   { "$value": "2.75rem", "$type": "dimension" }
    }
  },
  "badge": {
    "padding-x": { "$value": "0.625rem", "$type": "dimension" },
    "padding-y": { "$value": "0.125rem", "$type": "dimension" },
    "font-size": { "$value": "{font-size.xs}", "$type": "dimension" }
  },
  "avatar": {
    "size": {
      "sm":   { "$value": "2rem", "$type": "dimension" },
      "md":   { "$value": "2.5rem", "$type": "dimension" },
      "lg":   { "$value": "3rem", "$type": "dimension" }
    }
  },
  "card": {
    "padding": { "$value": "1.5rem", "$type": "dimension" }
  },
  "dialog": {
    "width": { "$value": "32rem", "$type": "dimension" },
    "padding": { "$value": "1.5rem", "$type": "dimension" }
  },
  "data-grid": {
    "height": {
      "$value": "min(32rem, 75dvh)",
      "$type": "dimension",
      "$description": "How tall a data grid is: the box its rows scroll in."
    }
  },
  "table": {
    "cell-padding-y": {
      "default": { "$value": "{spacing.3}", "$type": "dimension" },
      "compact": { "$value": "{spacing.1-5}", "$type": "dimension" }
    },
    "cell-padding-x": { "$value": "{spacing.3}", "$type": "dimension" },
    "max-height": {
      "$value": "min(32rem, 75dvh)",
      "$type": "dimension",
      "$description": "How tall a table with sticky-header grows before its rows scroll under the header."
    }
  }
}
