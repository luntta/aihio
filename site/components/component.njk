---
pagination:
  data: docs.components
  size: 1
  alias: component
permalink: "/components/{{ component.slug }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ component.name }}"
  description: "{{ component.description }}"
---
<section class="docs-page-intro">
  <div class="docs-eyebrow">
    <aihio-badge>{{ component.tag }}</aihio-badge>
    <aihio-badge variant="outline">v{{ component.version }}</aihio-badge>
    {% for intent in component.intentsDetailed %}
      <aihio-badge variant="secondary">{{ intent.name }}</aihio-badge>
    {% endfor %}
  </div>
  <h1>{{ component.name }}</h1>
  <p>{{ component.description }}</p>
</section>

{% if component.examplesDetailed.length %}
  <section>
    <div class="docs-section-heading">
      <div>
        <h2>Live examples</h2>
        <p>Rendered live from the schema, with the authored source beneath each preview.</p>
      </div>
    </div>

    <div class="docs-example-grid">
      {% for example in component.examplesDetailed %}
        {% set label = "Example" %}
        {% set title = example.title %}
        {% set description = example.description %}
        {% set markup = example.previewMarkup %}
        {% set source = example.markup %}
        {% set tone = "default" %}
        {% include "partials/example-frame.njk" %}
      {% endfor %}
    </div>
  </section>
{% endif %}

{% if component.counterExamplesDetailed.length %}
  <section>
    <div class="docs-section-heading">
      <div>
        <h2>Counterexamples</h2>
        <p>Markup the runtime warns about and the linter rejects, with the reason it is wrong.</p>
      </div>
    </div>

    <div class="docs-example-grid">
      {% for example in component.counterExamplesDetailed %}
        {% set label = "Counterexample" %}
        {% set title = example.title %}
        {% set description = example.reason %}
        {% set markup = example.previewMarkup %}
        {% set source = example.markup %}
        {% set tone = "warning" %}
        {% include "partials/example-frame.njk" %}
      {% endfor %}
    </div>
  </section>
{% endif %}

<section id="api">
  <div class="docs-section-heading">
    <div>
      <h2>API</h2>
      <p>Every attribute, property, method, and event the schema declares for <code>{{ component.tag }}</code>.</p>
    </div>
  </div>

  {% set api = component %}
  {% set level = 3 %}
  {% include "partials/api-reference.njk" %}

  {% if component.compositionEntries.length %}
    <h3 class="docs-api__heading">Composition</h3>
    <dl class="docs-api">
      {% for entry in component.compositionEntries %}
        <div class="docs-api__row">
          <dt>{{ entry.label }}</dt>
          <dd class="docs-api__type">
            {% for value in entry.values %}
              {% if value.url %}<a class="docs-code-link" href="{{ value.url | docsUrl(page.url) }}"><code>{{ value.code }}</code></a>
              {% elif value.code %}<code>{{ value.code }}</code>
              {% else %}<span class="docs-api__kind">{{ value.text }}</span>{% endif %}
            {% endfor %}
          </dd>
        </div>
      {% endfor %}
    </dl>
  {% endif %}
</section>

{% if component.subComponents.length %}
  <section id="sub-components">
    <div class="docs-section-heading">
      <div>
        <h2>Sub-components</h2>
        <p>Used only inside <code>{{ component.tag }}</code>, which gives them their roles and keyboard behaviour.</p>
      </div>
    </div>

    {% for sub in component.subComponents %}
      <div class="docs-subcomponent" id="{{ sub.anchor }}">
        <h3><code>&lt;{{ sub.tag }}&gt;</code></h3>
        <p class="docs-subcomponent__description">{{ sub.description }}</p>
        {% set api = sub %}
        {% set level = 4 %}
        {% include "partials/api-reference.njk" %}
      </div>
    {% endfor %}
  </section>
{% endif %}

<section id="accessibility">
  <div class="docs-section-heading">
    <div>
      <h2>Accessibility</h2>
      <p>
        What you have to provide, and what the component already does. The obligations with a rule are checked by
        <code>aihio-lint</code> and by the dev build's console warnings.
      </p>
    </div>
  </div>

  <h3 class="docs-api__heading">Your obligations</h3>
  {% if component.requiredA11y.length %}
    <ul class="docs-obligations">
      {% for rule in component.requiredA11y %}
        <li class="docs-obligations__item">
          <p class="docs-obligations__when">
            <aihio-badge variant="{% if rule.severity == 'error' %}destructive{% else %}warning{% endif %}">{{ rule.severity }}</aihio-badge>
            When {{ rule.when }}
          </p>
          <p class="docs-obligations__requirement">{{ rule.requirement }}</p>
          <p class="docs-obligations__rule">
            {% if rule.rule %}Checked as <code>{{ rule.rule }}</code>{% else %}Not machine-checkable: a judgment for the author.{% endif %}
          </p>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="docs-muted">None beyond using the component as documented.</p>
  {% endif %}

  <h3 class="docs-api__heading">Handled for you</h3>
  {% if component.handledA11y.length %}
    <ul class="docs-handled">
      {% for item in component.handledA11y %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="docs-muted">No automatic behaviour documented.</p>
  {% endif %}
</section>

{% if component.patternsUsing.length %}
  <section id="patterns">
    <div class="docs-section-heading">
      <div>
        <h2>In patterns</h2>
        <p>Canonical compositions that use <code>{{ component.tag }}</code>.</p>
      </div>
    </div>
    <ul class="docs-link-row">
      {% for pattern in component.patternsUsing %}
        <li><a class="docs-inline-link" href="{{ pattern.path | docsUrl(page.url) }}">{{ pattern.name }}</a></li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
