---
layout: layouts/base.njk
title: Semantic tokens
description: The semantic design tokens Aihio components are styled with.
---
<section class="docs-page-intro">
  <div class="docs-eyebrow">
    <aihio-badge>Foundations</aihio-badge>
    <aihio-badge variant="outline">{{ docs.semanticTokenCount }} semantic tokens</aihio-badge>
  </div>
  <h1>Semantic tokens</h1>
  <p>
    Primitive scales give values, semantic tokens give them a purpose, and components read only the purpose:
    <code>--aihio-color-surface-bg</code>, <code>--aihio-spacing-stack-md</code>, never a position on a scale. Every
    name is <code>--aihio-&lt;group&gt;-&lt;name&gt;</code>, and everything below is generated from
    <code>tokens/semantic.json</code>.
  </p>
</section>

<section>
  <div class="docs-section-heading">
    <div>
      <h2>The intent vocabulary</h2>
      <p>The {{ docs.intentCount }} named intents that the schema, the linter, and the prompt fragment all share.</p>
    </div>
  </div>

  <dl class="docs-vocab">
    {% for intent in docs.intents %}
      <div class="docs-vocab__row">
        <dt><code>{{ intent.name }}</code></dt>
        <dd>{{ intent.description }}</dd>
      </div>
    {% endfor %}
  </dl>
</section>

{% for group in docs.semanticTokenGroups %}
  <section>
    <div class="docs-section-heading">
      <div>
        <h2>{{ group.name }}</h2>
        <p>{{ group.intro }}</p>
      </div>
      <span class="docs-muted">{{ group.tokens.length }} tokens</span>
    </div>

    <div class="docs-tablewrap">
      <table class="docs-table docs-table--tokens">
        <thead>
          <tr>
            {% if group.name == 'color' %}<th><span class="docs-visually-hidden">Swatch</span></th>{% endif %}
            <th>CSS variable</th>
            <th>Source</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {% for token in group.tokens %}
            <tr>
              {% if group.name == 'color' %}
                <td class="docs-table__swatch-cell">
                  <span class="docs-swatch" style="background: var({{ token.variable }})"></span>
                </td>
              {% endif %}
              <td><code>{{ token.variable }}</code></td>
              <td><code class="docs-muted">{{ token.source }}</code></td>
              <td>{{ token.description }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endfor %}

<section>
  <div class="docs-section-heading">
    <div>
      <h2>Generated artifact</h2>
      <p>The same reference ships inside the package, as markdown and as JSON with resolved values for both themes, so agents read it without scraping this site.</p>
    </div>
    <aihio-cluster>
      <a class="docs-inline-link" href="{{ '/dist/semantic-tokens.md' | docsUrl(page.url) }}">semantic-tokens.md</a>
      <a class="docs-inline-link" href="{{ '/dist/tokens.json' | docsUrl(page.url) }}">tokens.json</a>
    </aihio-cluster>
  </div>
</section>
