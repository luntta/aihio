---
layout: layouts/base.njk
title: Patterns
description: Generated multi-component patterns for the Aihio design system.
---
<section class="docs-page-intro">
  <div class="docs-eyebrow">
    <aihio-badge>Pattern library</aihio-badge>
    <aihio-badge variant="outline">{{ docs.patternCount }} patterns</aihio-badge>
  </div>
  <h1>Patterns</h1>
  <p>
    Patterns document a composition rather than a single component: which components take part, how they nest, and what
    the authored markup looks like. They come from the same schema bundle that powers linting and prompt output.
  </p>
</section>

<section>
  <div class="docs-component-grid">
    {% for pattern in docs.patterns %}
      <aihio-card class="docs-component-card">
        <aihio-card-header>
          <div class="docs-component-card__meta">
            <aihio-badge variant="outline">{{ pattern.id }}</aihio-badge>
            <span class="docs-component-card__version">{{ pattern.componentEntries.length }} components</span>
          </div>
          <aihio-card-title>{{ pattern.name }}</aihio-card-title>
          <aihio-card-description>{{ pattern.description | prose | safe }}</aihio-card-description>
        </aihio-card-header>

        <aihio-card-content>
          <div class="docs-component-card__intents">
            {% for intent in pattern.intentsDetailed %}
              <aihio-badge variant="secondary">{{ intent.name }}</aihio-badge>
            {% endfor %}
          </div>
        </aihio-card-content>

        <aihio-card-footer>
          <a class="docs-inline-link" href="{{ pattern.path | docsUrl(page.url) }}">View pattern</a>
        </aihio-card-footer>
      </aihio-card>
    {% endfor %}
  </div>
</section>
