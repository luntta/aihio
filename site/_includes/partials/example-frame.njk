<figure class="docs-example{% if tone == 'warning' %} docs-example--warning{% endif %}">
  <figcaption class="docs-example__head">
    {% if tone == 'warning' %}
      <aihio-badge variant="destructive">{{ title }}</aihio-badge>
    {% else %}
      <span class="docs-example__label">{{ title }}</span>
    {% endif %}
    {% if meta %}<span class="docs-example__meta">{{ meta }}</span>{% endif %}
    {% if description %}<p class="docs-example__reason">{{ description }}</p>{% endif %}
  </figcaption>

  <div class="docs-example__preview{% if tone == 'warning' %} is-warning{% endif %}">
    {{ markup | safe }}
  </div>

  <pre class="docs-code"><code>{{ source | escape }}</code></pre>
</figure>
