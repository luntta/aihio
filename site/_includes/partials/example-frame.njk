{#- One example: a heading, an optional description, and one frame holding the
    live preview over its source. `id`, `title`, `description`, `markup`
    (rendered), `source` (shown), and `level` (heading level) are set by the
    caller. Source longer than a screenful is collapsed behind a toggle. -#}
<div class="docs-example" id="{{ id }}">
  <h{{ level or 3 }} class="docs-example__title">{{ title }}</h{{ level or 3 }}>
  {% if description %}<p class="docs-example__description">{{ description | prose | safe }}</p>{% endif %}

  <div class="docs-example__frame{% if resizable %} docs-example__frame--section{% endif %}">
    {% if resizable %}
      <div class="docs-example__toolbar">
        <aihio-cluster gap="tight" role="group" aria-label="Preview width" data-preview-widths>
          <aihio-toggle size="sm" variant="outline" pressed data-preview-width="">Full</aihio-toggle>
          <aihio-toggle size="sm" variant="outline" data-preview-width="40rem">Tablet</aihio-toggle>
          <aihio-toggle size="sm" variant="outline" data-preview-width="22rem">Phone</aihio-toggle>
        </aihio-cluster>
      </div>
    {% endif %}
    <div class="docs-example__preview">
      {{ markup | safe }}
    </div>

    {% set lines = source | lineCount %}
    {% if lines > 16 %}
      <details class="docs-example__source">
        <summary>Show code <span class="docs-muted">· {{ lines }} lines</span></summary>
        <pre class="docs-code"><code>{{ source | highlightHtml | safe }}</code></pre>
      </details>
    {% else %}
      <pre class="docs-code"><code>{{ source | highlightHtml | safe }}</code></pre>
    {% endif %}
  </div>
</div>
