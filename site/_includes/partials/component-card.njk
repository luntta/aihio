{#- A component in a grid: drawn live, then named, described, and linked. -#}
<article class="docs-component-card">
  {% if component.thumbnail %}
    <div class="docs-component-card__preview">{{ component.thumbnail | safe }}</div>
  {% endif %}
  <div class="docs-component-card__body">
    <h3 class="docs-component-card__title">
      <a href="{{ component.path | docsUrl(page.url) }}">{{ component.name }}</a>
    </h3>
    <p class="docs-component-card__description">{{ component.description | prose | safe }}</p>
    <p class="docs-component-card__meta"><code>&lt;{{ component.tag }}&gt;</code></p>
  </div>
</article>
