<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}Aihio</title>
  <meta name="description" content="{{ description or 'Aihio is an AI-first design system built on native web components.' }}">
  <meta name="color-scheme" content="light dark">
  <meta name="docs-root" content="{{ '/' | docsUrl(page.url) }}">
  <link rel="stylesheet" href="{{ '/dist/aihio.css' | docsUrl(page.url) }}">
  <link rel="stylesheet" href="{{ '/assets/docs.css' | docsUrl(page.url) }}">
  <script>
    /* Runs before first paint: a theme applied after the stylesheet lands
       would flash the wrong canvas on every navigation. */
    (function () {
      try {
        var stored = localStorage.getItem('aihio-docs-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      } catch (error) {
        /* Private mode and blocked storage both throw; the system theme is a
           correct answer, so there is nothing to recover from. */
      }
    })();
  </script>
  <script type="module" src="{{ '/dist/aihio.js' | docsUrl(page.url) }}"></script>
  <script type="module" src="{{ '/assets/docs.js' | docsUrl(page.url) }}"></script>
  <script type="module" src="{{ '/assets/search.js' | docsUrl(page.url) }}"></script>
</head>
<body>
  <a class="docs-skip" href="#docs-content">Skip to content</a>

  <header class="docs-topbar">
    <div class="docs-topbar__lead">
      <button
        class="docs-navtoggle"
        type="button"
        aria-expanded="false"
        aria-controls="docs-sidebar"
        data-nav-toggle
      >
        <span class="docs-navtoggle__glyph" aria-hidden="true"></span>
        <span class="docs-visually-hidden">Navigation</span>
      </button>

      <a class="docs-brand" href="{{ '/' | docsUrl(page.url) }}">
        <span class="docs-brand__mark" aria-hidden="true">A</span>
        <span class="docs-brand__name">Aihio</span>
      </a>
      <span class="docs-brand__version">v{{ docs.packageVersion }}</span>
    </div>

    <div class="docs-topbar__actions">
      <aihio-button class="docs-search-trigger" variant="outline" size="sm" commandfor="docs-search" command="--open">
        <span class="docs-search-trigger__label">Search</span>
        <kbd class="docs-search-trigger__key" aria-hidden="true">/</kbd>
      </aihio-button>

      <div class="docs-theme" role="group" aria-label="Colour theme">
        <button class="docs-theme__option" type="button" data-theme-option="light" aria-pressed="false">Light</button>
        <button class="docs-theme__option" type="button" data-theme-option="dark" aria-pressed="false">Dark</button>
        <button class="docs-theme__option" type="button" data-theme-option="system" aria-pressed="false">Auto</button>
      </div>

      <a class="docs-topbar__link" href="https://github.com/luntta/aihio">GitHub</a>
    </div>
  </header>

  <aihio-dialog id="docs-search" class="docs-search">
    <aihio-dialog-header>
      <aihio-dialog-title>Search</aihio-dialog-title>
      <aihio-dialog-description>
        Describe what you are building, or name a component, intent, or token. Components and patterns are ranked
        the way the MCP server's find tool ranks them for an agent.
      </aihio-dialog-description>
    </aihio-dialog-header>
    <form role="search" data-search-form>
      <aihio-input type="search" name="q" aria-label="Search the docs" placeholder="confirm before deleting a project" autofocus data-search-input></aihio-input>
    </form>
    <p class="docs-visually-hidden" role="status" data-search-status></p>
    <div class="docs-search__results" data-search-results></div>
  </aihio-dialog>

  <div class="docs-layout">
    <div class="docs-scrim" data-nav-scrim hidden></div>

    <aside class="docs-sidebar" id="docs-sidebar">
      <nav class="docs-sidenav" aria-label="Documentation">
        {% for section in navigation.sections %}
          <div class="docs-sidenav__group">
            <p class="docs-sidenav__heading">
              {% if section.url %}
                <a href="{{ section.url | docsUrl(page.url) }}">{{ section.title }}</a>
                <span class="docs-sidenav__count">{{ section.count }}</span>
              {% else %}
                {{ section.title }}
              {% endif %}
            </p>
            <ul class="docs-sidenav__list">
              {% for item in section.items %}
                <li>
                  <a
                    class="docs-sidenav__link"
                    href="{{ item.url | docsUrl(page.url) }}"
                    {% if page.url == item.url %}aria-current="page"{% endif %}
                  >{{ item.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </nav>

      {#- On a phone the top bar has no room for the theme switch, so it moves
          here. Both copies are painted by the same script. -#}
      <div class="docs-theme docs-theme--drawer" role="group" aria-label="Colour theme">
        <button class="docs-theme__option" type="button" data-theme-option="light" aria-pressed="false">Light</button>
        <button class="docs-theme__option" type="button" data-theme-option="dark" aria-pressed="false">Dark</button>
        <button class="docs-theme__option" type="button" data-theme-option="system" aria-pressed="false">Auto</button>
      </div>
    </aside>

    <main class="docs-main" id="docs-content">
      <div class="docs-content">
        {{ content | safe }}
      </div>

      <footer class="docs-footer">
        <p>
          <strong>Aihio</strong> · schema v{{ docs.schemaVersion }} ·
          {{ docs.componentCount }} components · {{ docs.patternCount }} patterns
        </p>
        <p class="docs-footer__note">
          Every page on this site is generated from <code>dist/schema.json</code> and built with the components it documents.
        </p>
      </footer>
    </main>
  </div>

  <script>
    (function () {
      var root = document.documentElement;
      var themeKey = 'aihio-docs-theme';

      function readTheme() {
        try {
          var stored = localStorage.getItem(themeKey);
          return stored === 'light' || stored === 'dark' ? stored : 'system';
        } catch (error) {
          return 'system';
        }
      }

      function paintThemeControl(theme) {
        for (var button of document.querySelectorAll('[data-theme-option]')) {
          button.setAttribute('aria-pressed', String(button.dataset.themeOption === theme));
        }
      }

      function setTheme(theme) {
        if (theme === 'system') {
          root.removeAttribute('data-theme');
        } else {
          root.setAttribute('data-theme', theme);
        }

        try {
          if (theme === 'system') {
            localStorage.removeItem(themeKey);
          } else {
            localStorage.setItem(themeKey, theme);
          }
        } catch (error) {
          /* The theme still applies for this page; it just will not persist. */
        }

        paintThemeControl(theme);
      }

      for (var button of document.querySelectorAll('[data-theme-option]')) {
        button.addEventListener('click', function (event) {
          setTheme(event.currentTarget.dataset.themeOption);
        });
      }

      paintThemeControl(readTheme());

      /* Mobile navigation drawer. */
      var toggle = document.querySelector('[data-nav-toggle]');
      var scrim = document.querySelector('[data-nav-scrim]');
      var sidebar = document.getElementById('docs-sidebar');

      function setNav(open) {
        root.toggleAttribute('data-nav-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        scrim.hidden = !open;

        if (open) {
          sidebar.querySelector('a').focus();
        } else {
          toggle.focus();
        }
      }

      toggle.addEventListener('click', function () {
        setNav(toggle.getAttribute('aria-expanded') !== 'true');
      });

      scrim.addEventListener('click', function () {
        setNav(false);
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          setNav(false);
        }
      });

      /* The drawer overlays the page, so a followed link must close it. */
      sidebar.addEventListener('click', function (event) {
        if (event.target.closest('a') && toggle.getAttribute('aria-expanded') === 'true') {
          setNav(false);
        }
      });
    })();
  </script>
</body>
</html>
