{
  "name": "@luntta/aihio",
  "version": "2.5.0",
  "description": "AI-first design system built on native web components. Zero dependencies.",
  "type": "module",
  "main": "./dist/aihio.js",
  "types": "./dist/aihio.d.ts",
  "bin": {
    "aihio": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/aihio.d.ts",
      "default": "./dist/aihio.js"
    },
    "./dev": {
      "types": "./dist/aihio.d.ts",
      "default": "./dist/aihio.dev.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    },
    "./components/dev": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.dev.js"
    },
    "./alert": {
      "types": "./dist/alert.d.ts",
      "default": "./dist/alert.js"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "default": "./dist/avatar.js"
    },
    "./badge": {
      "types": "./dist/badge.d.ts",
      "default": "./dist/badge.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "default": "./dist/button.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "default": "./dist/calendar.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "default": "./dist/card.js"
    },
    "./cluster": {
      "types": "./dist/cluster.d.ts",
      "default": "./dist/cluster.js"
    },
    "./combobox": {
      "types": "./dist/combobox.d.ts",
      "default": "./dist/combobox.js"
    },
    "./data-grid": {
      "types": "./dist/data-grid.d.ts",
      "default": "./dist/data-grid.js"
    },
    "./date-picker": {
      "types": "./dist/date-picker.d.ts",
      "default": "./dist/date-picker.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "default": "./dist/dialog.js"
    },
    "./dropdown": {
      "types": "./dist/dropdown.d.ts",
      "default": "./dist/dropdown.js"
    },
    "./field": {
      "types": "./dist/field.d.ts",
      "default": "./dist/field.js"
    },
    "./grid": {
      "types": "./dist/grid.d.ts",
      "default": "./dist/grid.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "default": "./dist/input.js"
    },
    "./pagination": {
      "types": "./dist/pagination.d.ts",
      "default": "./dist/pagination.js"
    },
    "./stack": {
      "types": "./dist/stack.d.ts",
      "default": "./dist/stack.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "default": "./dist/switch.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "default": "./dist/table.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "default": "./dist/tabs.js"
    },
    "./toggle": {
      "types": "./dist/toggle.d.ts",
      "default": "./dist/toggle.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "default": "./dist/prompt.js"
    },
    "./lint": {
      "types": "./dist/lint.d.ts",
      "default": "./dist/lint.js"
    },
    "./css": "./dist/aihio.css",
    "./schema": "./dist/schema.json",
    "./schema/min": "./dist/schema.min.json",
    "./tokens": "./dist/tokens.json",
    "./tokens.md": "./dist/semantic-tokens.md",
    "./dtcg/*": "./dist/dtcg/*",
    "./prompt.md": "./dist/aihio.prompt.md"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tokens": "node src/tokens/build.js",
    "styles": "node src/schema/build.js && node src/css/build.js",
    "schema": "node src/schema/build.js",
    "dev": "node dev.js",
    "build": "node build.js",
    "docs:build": "npm run build && eleventy",
    "docs:dev": "node dev.js",
    "docs:test": "node --test test/docs-build.check.js",
    "test": "npm run build && node --test test/browser.test.js test/build.test.js test/lint-fixtures.test.js test/lint-parser.test.js test/mcp.test.js",
    "check": "npm test && npm run typecheck && npm run docs:build && npm run docs:test && npm run test:browsers",
    "prepare": "npm run build",
    "version": "npm run build && git add docs/tokens.json src/schema/runtime-schema.js",
    "test:frameworks:build": "node test/frameworks/build.js",
    "test:browsers": "npm run build && npm run test:frameworks:build && playwright test",
    "typecheck": "npm run build && tsc -p tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luntta/aihio.git"
  },
  "keywords": [
    "design-system",
    "web-components",
    "ai-first",
    "design-tokens",
    "ui",
    "components",
    "zero-dependency"
  ],
  "author": "Raine Luntta <raine.luntta@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/luntta/aihio/issues"
  },
  "homepage": "https://github.com/luntta/aihio#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.25.0",
    "parse5": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svelte": "^5.57.0",
    "typescript": "^7.0.2",
    "vue": "^3.5.42"
  },
  "sideEffects": [
    "./dist/aihio.js",
    "./dist/aihio.dev.js",
    "./dist/components.dev.js",
    "./dist/*.css"
  ]
}
